# .env.local.example — 복사해서 .env.local 로 쓴다 (cp .env.local.example .env.local)
# 검증 규칙: src/lib/env/server.ts · src/lib/env/client.ts
# 값이 비었거나 형식이 틀리면 `npm run build` 가 실패한다.

# ---------- 서버 전용 ----------
# Spring(Render) 주소. 로컬 백엔드면 http://localhost:8080
SPRING_API_BASE_URL=http://localhost:8080
# Render 와 같은 값, 32자 이상. 생성: openssl rand -base64 48
JWT_SECRET=
# 16자 이상. 생성: openssl rand -hex 16
REVALIDATE_SECRET=

# ---------- 공개 (브라우저 노출) ----------
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://example.r2.dev
# 비워 두면 GA 비활성 (로컬 · Preview 권장)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
