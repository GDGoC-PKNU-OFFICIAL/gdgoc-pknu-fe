# FRONT_ARCHITECTURE v1.2 § 7 — 환경변수
# 실제 값은 .env.local 에 넣는다. 이 파일은 예시이므로 커밋된다.
# lib/env.ts 가 zod 로 부팅 시 검증하므로, 빠진 값은 런타임 500 이 아니라 빌드 실패로 잡힌다.

# ── 서버 전용 (브라우저에 노출되지 않는다) ─────────────────────
# Spring API 베이스 URL (Render). 공개 페이지는 빌드 · ISR 시점에만 호출한다.
SPRING_API_BASE_URL=https://example.onrender.com

# JWT 서명 검증 키. Render(Spring) 와 반드시 동일한 값이어야 한다.
JWT_SECRET=

# 수동 재검증 시크릿 (POST /api/revalidate 의 x-revalidate-secret 헤더)
REVALIDATE_SECRET=

# ── 공개 (NEXT_PUBLIC_ 접두사는 브라우저 번들에 포함된다) ───────
# R2 공개 호스트. next.config.ts 의 images.remotePatterns 에도 등록해야 한다.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# GA4 측정 ID
NEXT_PUBLIC_GA_ID=

# OG 이미지 · sitemap 절대경로의 기준
NEXT_PUBLIC_SITE_URL=http://localhost:3000
