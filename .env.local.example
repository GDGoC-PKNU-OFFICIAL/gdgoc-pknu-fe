# FRONT_ARCHITECTURE § 7 — 환경변수
# 실제 값은 .env.local 에 넣는다. 이 파일은 예시이므로 커밋된다.
# lib/env/server.ts · lib/env/client.ts 가 import 될 때 zod 로 검증한다.
# - 공개 변수: app/layout.tsx 가 client.ts 를 import 하므로 빠지면 빌드 실패
# - 서버 변수: lib/api/public-api.ts(Phase 2)가 server.ts 를 import 한 뒤부터 빌드에서 검증된다

# ── 서버 전용 (브라우저에 노출되지 않는다) ─────────────────────
# Spring API 베이스 URL (Render). 공개 페이지는 빌드 · ISR 시점에만, 관리자는 BFF 를 거쳐 호출한다.
SPRING_API_BASE_URL=https://example.onrender.com

# JWT 서명 검증 키 (proxy.ts · jose). Render(Spring) 와 반드시 동일한 값, 32자 이상.
# 생성 예: openssl rand -base64 48
JWT_SECRET=

# 수동 재검증 시크릿 (POST /api/revalidate 의 x-revalidate-secret 헤더), 16자 이상
REVALIDATE_SECRET=

# ── 공개 (NEXT_PUBLIC_ 접두사는 브라우저 번들에 포함된다) ───────
# R2 공개 주소 https://{bucket-id}.r2.dev (필수 · 끝의 / 없이).
# next.config.ts 의 images.remotePatterns 에도 등록한다 (Phase 2).
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://example.r2.dev

# GA4 측정 ID (G-XXXX). 비워 두면 GA 비활성 — 로컬 · Preview 에서 통계 오염 방지
NEXT_PUBLIC_GA_ID=

# OG 이미지 · sitemap 절대경로의 기준. 운영: https://{vercel-app}.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
